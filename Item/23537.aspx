nt-size: 12px">基本军事技能训练</span></p></td><td width="110" valign="center" style="padding: 0px 7px; border-width: 1px; border-style: solid; border-left-color: initial; border-right-color: rgb(0, 0, 0); border-top-color: initial; border-bottom-color: rgb(0, 0, 0);"><p style="vertical-align: middle"><span style="font-family: 仿宋;font-size: 12px">操场</span></p></td><td width="198" valign="center" style="padding: 0px 7px; border-width: 1px; border-style: solid; border-left-color: initial; border-right-color: rgb(0, 0, 0); border-top-color: initial; border-bottom-color: rgb(0, 0, 0);"><p style="vertical-align: middle"><span style="font-family: 仿宋;font-size: 12px">教官、班主任、德育处</span></p></td></tr><tr style="height:24px"><td width="84" valign="center" style="padding: 0px 7px; border-width: 1px; border-style: solid; border-left-color: initial; border-right-color: rgb(0, 0, 0); border-top-color: initial; border-bottom-color: rgb(0, 0, 0);"><p style=";text-align:center;vertical-align:middle"><span style="font-family: 仿宋;font-size: 12px">10:40-11:50</span></p></td><td width="214" valign="center" style="padding: 0px 7px; border-width: 1px; border-style: solid; border-left-color: initial; border-right-color: rgb(0, 0, 0); border-top-color: initial; border-bottom-color: rgb(0, 0, 0);"><p style="vertical-align: middle"><span style="font-family: 仿宋;font-size: 12px">基本军事知识</span></p></td><td width="110" valign="center" style="padding: 0px 7px; border-width: 1px; border-style: solid; border-left-color: initial; border-right-color: rgb(0, 0, 0); border-top-color: initial; border-bottom-color: rgb(0, 0, 0);"><p style="vertical-align: middle"><span style="font-family: 仿宋;font-size: 12px">报告厅</span></p></td><td valign="center" style="padding: 0px 7px; border-width: 1px; border-style: solid; border-left-color: initial; border-right-color: rgb(0, 0, 0); border-top-color: initial; border-bottom-color: rgb(0, 0, 0);"><p style="vertical-align: middle"><span style="font-family: 仿宋;font-size: 12px">年管会