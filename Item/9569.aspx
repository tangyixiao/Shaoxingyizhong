/201812/2018122510322880.jpg" onload=resizepic(this)><BR><BR><IMG onmousewheel="return bbimg(this)" border=0 hspace=0 alt="" src="/Shaoxingyizhong/UploadFiles/UploadFiles/201812/2018122510330753.jpg" onload=resizepic(this)><BR><BR><IMG onmousewheel="return bbimg(this)" border=0 hspace=0 alt="" src="/Shaoxingyizhong/UploadFiles/UploadFiles/201812/2018122510330744.jpg" onload=resizepic(this)><BR><BR><IMG onmousewheel="return bbimg(this)" border=0 hspace=0 alt="" src="/Shaoxingyizhong/UploadFiles/UploadFiles/201812/2018122510330723.jpg" onload=resizepic(this)><BR><BR><IMG onmousewheel="return bbimg(this)" border=0 hspace=0 alt="" src="/Shaoxingyizhong/UploadFiles/UploadFiles/201812/2018122510330762.jpg" onload=resizepic(this)><BR><BR><IMG onmousewheel="return bbimg(this)" border=0 hspace=0 alt="" src="/Shaoxingyizhong/UploadFiles/UploadFiles/201812/2018122510330743.jpg" onload=resizepic(this)><BR><BR><IMG onmousewheel="return bbimg(this)" border=0 hspace=0 alt="" src="/Shaoxingyizhong/UploadFiles/UploadFiles/201812/2018122510330726.jpg" onload=resizepic(this)><BR><BR></P>
<P style="TEXT-ALIGN: left; TEXT-INDENT: 18pt; MARGIN: 0cm 0cm 0pt; BACKGROUND: white; mso-char-indent-count: 1.5; mso-pagination: widow-orphan" class=MsoNormal align=left><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt" lang=EN-US>12</SPAN><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt">月<SPAN lang=EN-US>17</SPAN>—<SPAN lang=EN-US>19</SPAN>日，虽是寒冬腊月，但却阳光明媚，<SPAN lang=EN-US>2018</SPAN>年浙江省高中生物“疑难问题解决”专题研训在名人辈出的绍兴市第一中学隆重举行。本次会议由浙江省教育厅教研室主办，绍兴市教育教学研究院承办，绍兴市第一中学协办。活动以“指向学科核心素养的高中生物教学与评价”为主题，由专家学术报告、学科基地建设成果展示、现场观摩研究课等三个板块组成。<SPAN lang=EN-US><?xml:namespace prefix = o ns = "urn:schemas-microsoft-com:office:office" /><o:p></o:p></SPAN></SPAN></P>
<P style="TEXT-ALIGN: left; TEXT-INDENT: 18pt; MARGIN: 0cm 0cm 0pt; BACKGROUND: white; mso-char-indent-count: 1.5; mso-pagination: widow-orphan" class=MsoNormal align=left><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt" lang=EN-US>18</SPAN><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt">日上午开幕式由浙江省教育厅教研室高中生物教研员、特级教师周初霞老师主持。出席开幕式的领导和专家有北京师范大学生命科学学院教授，博士生导师、生物学教育系主任刘恩山，浙江省教育学会中学生物教学分会副理事长，特级教师赵沛荣，浙江省科技出版社总编辑章建林，绍兴市教育教学研究院党委书记赵新鸿，绍兴一中党委书记陈银伟。赵书记和陈书记分别代表市教育教学研究院和绍兴一中致欢迎词。本次活动云集了浙江省生物特级教师、各地（市、县）教研员、骨干教师<SPAN lang=EN-US>350</SPAN>余人。<SPAN lang=EN-US><o:p></o:p></SPAN></SPAN></P>
<P style="TEXT-ALIGN: center; LINE-HEIGHT: 26.25pt; MARGIN: 0cm 0cm 0pt; BACKGROUND: white; mso-pagination: widow-orphan" class=MsoNormal align=center><SPAN style="FONT-FAMILY: '微软雅黑','sans-serif'; LETTER-SPACING: 1.5pt; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt" lang=EN-US><o:p> </o:p></SPAN></P>
<P style="TEXT-ALIGN: left; LINE-HEIGHT: 26.25pt; TEXT-INDENT: 180pt; MARGIN: 0cm 0cm 0pt; BACKGROUND: white; mso-char-indent-count: 12.0; mso-pagination: widow-orphan" class=MsoNormal align=left><SPAN style="FONT-FAMILY: '微软雅黑','sans-serif'; LETTER-SPACING: 1.5pt; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt" lang=EN-US>1<o:p></o:p></SPAN></P>
<P style="TEXT-ALIGN: left; TEXT-INDENT: 90.3pt; MARGIN: 0cm 0cm 0pt; BACKGROUND: white; mso-char-indent-count: 6.0; mso-pagination: widow-orphan" class=MsoNormal align=left><B><SPAN style="FONT-FAMILY: 宋体; LETTER-SPACING: 1.5pt; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt">专家学术报告，解读论证教学<SPAN lang=EN-US><o:p></o:p></SPAN></SPAN></B></P>
<P style="TEXT-ALIGN: left; TEXT-INDENT: 24.1pt; MARGIN: 0cm 0cm 0pt; BACKGROUND: white; mso-pagination: widow-orphan" class=MsoNormal align=left><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-ascii-theme-font: minor-latin; mso-fareast-font-family: 宋体; mso-fareast-theme-font: minor-fareast; mso-hansi-theme-font: minor-latin; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri">本次研训特别邀请了高中生物学课程标准项目负责人刘恩山教授及其博士生杨铭。刘教授和杨博士以教师工作坊的活动形式给大家带来了一场名为“论证式教学策略在中学生物学课堂中的应用”的专题报告。论证式教学是一种强调培养学生利用证据进行合理推理并提出主张的能力，是一种促进学生对科学概念和科学本质理解的，培养学生科学思维方式的教学模式。刘教授和杨博士从“饮食中是否有必要添加益生菌”</SPAN><SPAN style="FONT-SIZE: 12pt"><FONT face=Calibri> </FONT></SPAN><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-ascii-theme-font: minor-latin; mso-fareast-font-family: 宋体; mso-fareast-theme-font: minor-fareast; mso-hansi-theme-font: minor-latin; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri">、“植物通过光合作用增重是依靠什么”、“请你鉴定哪个是人工甜味剂”、“荧光猫的遗传方式”四个活动，以现场互动的方式，引发与会教师对</SPAN><SPAN style="FONT-SIZE: 12pt" lang=EN-US><FONT face=Calibri>CER</FONT></SPAN><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-ascii-theme-font: minor-latin; mso-fareast-font-family: 宋体; mso-fareast-theme-font: minor-fareast; mso-hansi-theme-font: minor-latin; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri">论证模式的深入思考和亲身体验，与会老师积极参与、主动发言，现场气氛空前活跃，</SPAN><SPAN style="FONT-SIZE: 12pt" lang=EN-US><FONT face=Calibri>5</FONT></SPAN><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-ascii-theme-font: minor-latin; mso-fareast-font-family: 宋体; mso-fareast-theme-font: minor-fareast; mso-hansi-theme-font: minor-latin; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri">个小时的交流报告，在愉快、思辨、碰撞中结束，但我们还是意犹未尽！报告的内容给教师解惑了“论证式教学策略如何在中学生物学课程中应用”，报告的形式又呈现了开展论证式教学的实践范式。</SPAN><FONT face=Calibri><SPAN style="FONT-SIZE: 12pt" lang=EN-US> </SPAN><B><SPAN style="FONT-FAMILY: 宋体; LETTER-SPACING: 1.5pt; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt" lang=EN-US><o:p></o:p></SPAN></B></FONT></P>
<P style="TEXT-ALIGN: left; TEXT-INDENT: 24.1pt; MARGIN: 0cm 0cm 0pt; BACKGROUND: white; mso-pagination: widow-orphan" class=MsoNormal align=left><SPAN style="FONT-SIZE: 12pt" lang=EN-US><o:p><FONT face=Calibri> </FONT></o:p></SPAN></P>
<P style="LINE-HEIGHT: 26.25pt; TEXT-INDENT: 180pt; MARGIN: 0cm 0cm 0pt; BACKGROUND: white; mso-char-indent-count: 12.0; mso-pagination: widow-orphan" class=MsoNormal><SPAN style="FONT-FAMILY: '微软雅黑','sans-serif'; LETTER-SPACING: 1.5pt; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt" lang=EN-US>2<o:p></o:p></SPAN></P>
<P style="TEXT-INDENT: 67.7pt; MARGIN: 0cm 0cm 0pt; mso-char-indent-count: 4.5" class=MsoNormal><B><SPAN style="FONT-FAMILY: 宋体; LETTER-SPACING: 1.5pt; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt">学科基地介绍，展示一中生物风采<SPAN lang=EN-US><o:p></o:p></SPAN></SPAN></B></P>
<P style="TEXT-INDENT: 18pt; MARGIN: 0cm 0cm 0pt; mso-char-indent-count: 1.5" class=MsoNormal><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-ascii-theme-font: minor-fareast; mso-fareast-font-family: 宋体; mso-fareast-theme-font: minor-fareast; mso-hansi-theme-font: minor-fareast" lang=EN-US>18</SPAN><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-ascii-theme-font: minor-fareast; mso-fareast-font-family: 宋体; mso-fareast-theme-font: minor-fareast; mso-hansi-theme-font: minor-fareast">日下午，在刘教授和杨博士的主题报告后，绍兴一中生物教研组长沈初见以“基于学科核心素养培养的高中生物学科基地建设”为题作了学科基地建设经验介绍。沈老师介绍了<SPAN lang=EN-US>2014</SPAN>～<SPAN lang=EN-US>2018</SPAN>年期间，绍兴一中在培育和深化建设省高中生物学科基地学校过程中所采取的典型经验措施及取得的丰硕成果。报告主要围绕完善学科课程体系、变革课堂教学范式、推进学校创新实验室建设、加大学校课程资源建设、扩大基地学校辐射影响、学科基地成果简介等方面展开，内容详实、可借鉴性强，受到与会教师的高度评价。</SPAN><B><SPAN style="FONT-FAMILY: 宋体; LETTER-SPACING: 1.5pt; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt" lang=EN-US><o:p></o:p></SPAN></B></P>
<P style="LINE-HEIGHT: 26.25pt; MARGIN: 0cm 0cm 0pt; BACKGROUND: white; mso-pagination: widow-orphan" class=MsoNormal><FONT face=Calibri><SPAN style="COLOR: red; FONT-SIZE: 12pt" lang=EN-US><SPAN style="mso-spacerun: yes">  </SPAN></SPAN><SPAN style="FONT-FAMILY: '微软雅黑','sans-serif'; LETTER-SPACING: 1.5pt; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt" lang=EN-US><o:p></o:p></SPAN></FONT></P>
<P style="LINE-HEIGHT: 26.25pt; TEXT-INDENT: 180pt; MARGIN: 0cm 0cm 0pt; BACKGROUND: white; mso-char-indent-count: 12.0; mso-pagination: widow-orphan" class=MsoNormal><SPAN style="FONT-FAMILY: '微软雅黑','sans-serif'; LETTER-SPACING: 1.5pt; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt" lang=EN-US>3<o:p></o:p></SPAN></P>
<P style="TEXT-ALIGN: left; MARGIN: 0cm 0cm 0pt; BACKGROUND: white; mso-pagination: widow-orphan" class=MsoNormal align=left><B><SPAN style="FONT-FAMILY: 宋体; LETTER-SPACING: 1.5pt; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt" lang=EN-US><SPAN style="mso-spacerun: yes">        </SPAN></SPAN></B><B><SPAN style="FONT-FAMILY: 宋体; LETTER-SPACING: 1.5pt; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt">课例展示研讨，指向素养“落地”<SPAN lang=EN-US><o:p></o:p></SPAN></SPAN></B></P>
<P style="TEXT-ALIGN: left; TEXT-INDENT: 18pt; MARGIN: 0cm 0cm 0pt; BACKGROUND: white; mso-char-indent-count: 1.5; mso-pagination: widow-orphan" class=MsoNormal align=left><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt" lang=EN-US>19</SPAN><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt">日上午活动由绍兴市高中生物教研员邵乃军老师主持。两节现场研究课在老师们的期待中亮相。首先，绍兴一中范捷老师的一节“高等动物的内分泌系统和体液调节”的研究课，师生共同展示了一堂完整的、精彩的论证式教学的课堂。范老师运用“<SPAN lang=EN-US>CER</SPAN>论证教学模式”，从“提出主张、以资料推理主张、以理由辩护主张、以理由质疑他人主张”展开教学。在论证的过程中，学生通过小组合作进行论证、展示、质疑、修改，这不但调动了学生的学习积极性，也让学生体验到了类似科学家论证的过程，以实现概念教学与科学思维培养相融合的教学。<SPAN lang=EN-US><o:p></o:p></SPAN></SPAN></P>
<P style="MARGIN: 0cm 0cm 0pt" class=MsoNormal><B><SPAN style="FONT-FAMILY: 宋体; LETTER-SPACING: 1.5pt; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt" lang=EN-US><SPAN style="mso-spacerun: yes">  </SPAN></SPAN></B><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt">接着，杭师大附中周丽婷老师的一节“生态系统的能量流动”的研究课，以“系统论”思想方法为主线，建模和模型凸显科学思维；分析能量流动的特点和规律分析，促进领悟<SPAN lang=EN-US>“</SPAN>生命观念<SPAN lang=EN-US>”</SPAN>；应用所学知识讨论<SPAN lang=EN-US>“</SPAN>桑基鱼塘<SPAN lang=EN-US>”</SPAN>等生产、生活实践问题，形成生态意识和尝试解决现实生活问题的社会责任意识。在林德曼研究的科学史的真实情境中，学生通过完成能量流动定性、定量模型建构和分析应用的活动来体验与感悟。</SPAN><SPAN style="LAYOUT-GRID-MODE: line; FONT-FAMILY: 'Times New Roman','serif'; BACKGROUND: black; FONT-SIZE: 0pt; mso-fareast-font-family: 'Times New Roman'; mso-font-kerning: 0pt; mso-font-width: 0%"> </SPAN><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt">该课较好地体现了核心素养在生物课堂教学中的落实。<SPAN lang=EN-US><o:p></o:p></SPAN></SPAN></P>
<P style="TEXT-ALIGN: left; MARGIN: 0cm 0cm 0pt; BACKGROUND: white; mso-pagination: widow-orphan" class=MsoNormal align=left><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt" lang=EN-US><SPAN style="mso-spacerun: yes">   </SPAN></SPAN><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt">之后，范老师和周老师又分别进行了课后说课。最后，长兴县研训中心书记陈桂林老师和宁波二中书记叶惠良老师分别对范老师和周老师的两节研究课进行了有针对性的点评。陈书记认为绍兴一中的范捷老师给我们展示了一堂完整的、精彩的论证式教学的课堂。论证式教学是实现发展学生核心素养的一种很好的模式之一。因为论证式教学是学生在课堂上论证，因此必定是学生主体的；因为要辩护与反驳，学生必定是有兴趣的、愿意思考的；生物学的概念一定是从过程中建构的，必定能达到理解的层次。在这个过程中，学生的阅读、聆听、思考、书写、口说得到充分的训练和展示。<SPAN lang=EN-US><o:p></o:p></SPAN></SPAN></P>
<P style="TEXT-INDENT: 24pt; MARGIN: 0cm 0cm 0pt; mso-char-indent-count: 2.0" class=MsoNormal><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt">叶书记认为周老师和学生共同演绎了一节含金量高，引发思考，给人启迪的好课。一是教学设计引人入胜。周老师以“林德曼对赛达伯格湖能量流动的研究”科学史为情境，围绕“为何要用系统分析法进行生态系统的研究”“如何研究生态系统能量流动的规律”“怎样应用生态系统能量流动的知识解释生产实践中的问题和现象”三个问题，搭建“构建生态系统能量流动定性模型”“构建生态系统能量流动定量模型”“对生态城市建设出谋划策”三个活动载体，希望以情景教学、问题教学和小组合作学习等教与学的方法展开教学活动，以期落实生物学核心素养。二是教学实施有生长感。在课堂中，周老师非常关注通过搭支架来帮助学生运用自己的知识解决真实的问题，如能量流动定性模型和定量模型的建构，学生积极性很高，小组合作的氛围很好。对于过程中容易出差错的地方，包括学生出现的小错误，周老师也处理得非常老到，给学生提供了足够的信息、指导和支撑。另外周老师在师生互动、教与学以及评价等环节也做得比较到位，把教学过程和评价策略作为一个整体进行了考虑，体现了新课标“教<SPAN lang=EN-US>-</SPAN>学<SPAN lang=EN-US>-</SPAN>评一体化”实施的要求。整堂课学生学习生物的兴趣较为浓厚，有生长感。<SPAN lang=EN-US><o:p></o:p></SPAN></SPAN></P>
<P style="LINE-HEIGHT: 26.25pt; TEXT-INDENT: 180pt; MARGIN: 0cm 0cm 0pt; BACKGROUND: white; mso-char-indent-count: 12.0; mso-pagination: widow-orphan" class=MsoNormal><SPAN style="FONT-FAMILY: '微软雅黑','sans-serif'; LETTER-SPACING: 1.5pt; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt" lang=EN-US>4<o:p></o:p></SPAN></P>
<P style="TEXT-ALIGN: left; TEXT-INDENT: 112.85pt; MARGIN: 0cm 0cm 0pt; BACKGROUND: white; mso-char-indent-count: 7.5; mso-pagination: widow-orphan" class=MsoNormal align=left><B><SPAN style="FONT-FAMILY: 宋体; LETTER-SPACING: 1.5pt; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt">专家总结发言，指明研究方向<SPAN lang=EN-US><o:p></o:p></SPAN></SPAN></B></P>
<P style="TEXT-ALIGN: left; TEXT-INDENT: 24pt; MARGIN: 0cm 0cm 0pt; BACKGROUND: white; mso-char-indent-count: 2.0; mso-pagination: widow-orphan" class=MsoNormal align=left><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt">浙江省教育厅教研室高中生物教研员、特级教师周初霞作了“指向学科核心素养的高中生物教学与评价”的总结发言。周老师首先总结了近<SPAN lang=EN-US>3</SPAN>年我省高中生物“疑难问题解决”专题研训紧紧围绕“指向学科核心素养的高中生物教学与评价”这一主题，从高中生物学科课程标准的解读、生物学学科核心素养的学习和深入领悟，再到学科核心素养在课堂教学与评价中的“落地”，步步深入，层层落实。总结了我省课程改革背景下高中生物教学所取得的丰硕成果，指出了教学的现状与问题。同时，周老师指出刘教授团队的主题报告“论</SPAN><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-ascii-theme-font: minor-latin; mso-fareast-font-family: 宋体; mso-fareast-theme-font: minor-fareast; mso-hansi-theme-font: minor-latin; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri">证式教学策略在中学生物学课堂中的应用</SPAN><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt">”是一个非常好的科学思维落地的范式，值得我们学习借鉴；并就“论证式教学策略”在高中生物教学中如何落地进行了深度阐释，建议与会代表要积极开展“论证式教学”等指向学科核心素养的教学与评价的课例研究；强调生物学是理科，理科要让学生学会“说理”，而不能唯知识的死记硬背。最后，周老师建议学科组要开展“指向学科核心素养的高中生物教学与评价”的整体备课，即从课程层面、模块层面、单元层面和每节课的层面思考学科核心素养、学科观点、核心概念，围绕核心素养和核心概念组织教学。要求老师能从知识本位转向素养为主，从“教书”转向“育人”，为新一轮教育教学的改革指明了方向。<SPAN lang=EN-US><o:p></o:p></SPAN></SPAN></P>
<P style="TEXT-INDENT: 24pt; MARGIN: 0cm 0cm 0pt; mso-char-indent-count: 2.0" class=MsoNormal><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体; mso-font-kerning: 0pt">本次活动，虽然时间短促，但内容前沿，主题突出，形式多样，效果显著。与会老师们纷纷表示不仅在教育理念上接受启迪，开阔视野，而且在教学方法上感悟教学，受益匪浅。</SPAN><SPAN style="FONT-FAMILY: 宋体; FONT-SIZE: 12pt; mso-bidi-font-family: 宋体" lang=EN-US><o:p></o:p></SPAN></P>
<P align=center> </P>
    
