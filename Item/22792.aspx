;page-break-inside:avoid"><td width="126" valign="center" style="padding: 0px 7px; border-width: 1px 1px 1px 2px; border-color: windowtext;"><p><span style=";font-family:'Times New Roman';font-size:14px">初中英语</span></p></td><td width="97" valign="center" style="padding: 0px 7px; border-width: 1px; border-color: windowtext;"><p style=";text-align:center"><span style="font-family:'Times New Roman';font-size:14px">6</span></p></td><td width="217" valign="center" style="padding: 0px 7px; border-width: 1px; border-color: windowtext;"><p><span style=";font-family:'Times New Roman';font-size:14px">高中生涯规划</span></p></td><td width="93" valign="center" style="padding: 0px 7px; border-width: 1px 2px 1px 1px; border-color: windowtext;"><p style=";text-align:center"><span style="font-family:'Times New Roman';font-size:14px">6</span></p></td></tr><tr style="height:30px;page-break-inside:avoid"><td width="126" valign="center" style="padding: 0px 7px; border-width: 1px 1px 1px 2px; border-color: windowtext;"><p><span style=";font-family:'Times New Roman';font-size:14px">初中道德与法治</span></p></td><td width="97" valign="center" style="padding: 0px 7px; border-width: 1px; border-color: windowtext;"><p style=";text-align:center"><span style="font-family:'Times New Roman';font-size:14px">6</span></p></td><td width="217" valign="center" style="padding: 0px 7px; border-width: 1px; border-color: windowtext;"><p><span style=";font-family:'Times New Roman';font-size:14px">幼儿教育</span><span style=";font-family:'Times New Roman';font-size:14px">（城乡）</span></p></td><td width="93" valign="center" style="padding: 0px 7px; border-width: 1px 2px 1px 1px; border-color: windowtext;"><p style=";text-align:center"><span style=";font-family:'Times New Roman';font-size:14px">6+6</span></p></td></tr><tr style="height:30px;page-break-inside:avoid"><td width="126" valign="center" style="padding: 0px 7px; border-width: 1px 1px 1px 2px; border-color: windowtext;"><p><span style=";font-family:'Times New Roman';font-size:14px">初中地理</span></p></td><td width="97" valign="center" style="padding: 0px 7px; border-width: 1px; border-color: windowtext;"><p style=";text-align:center"><span style="font-family:'Times New Roman';font-size:14px">6</span></p></td><td width="217" valign="center" style="padding: 0px 7px; border-width: 1px; border-color: windowtext;"><p><span style=";font-family:'Times New Roman';font-size:14px">特殊教育</span></p></td><td width="93" valign="center" style="padding: 0px 7px; border-width: 1px 2px 1px 1px; border-color: windowtext;"><p style=";text-align:center"><span style="font-family:'Times New Roman';font-size:14px">4</span></p></td></tr><tr style="height:30px;page-break-inside:avoid"><td width="126" valign="center" style="padding: 0px 7px; border-width: 1px 1px 1px 2px; border-color: windowtext;"><p><span style=";font-family:'Times New Roman';font-size:14px">初中科学</span></p></td><td width="97" valign="center" style="padding: 0px 7px; border-width: 1px; border-color: windowtext;"><p style=";text-align:center"><span style="font-family:'Times New Roman';font-size:14px">6</span></p></td><td width="217" valign="center" style="padding: 0px 7px; border-width: 1px; border-color: windowtext;"><p><span style=";font-family:'Times New Roman';font-size:14px">中小学班会课（小初高）</span></p></td><td width="93" valign="center" style="padding: 0px 7px; border-width: 1px 2px 1px 1px; border-color: windowtext;"><p style=";text-align:center"><span style="font-family:'Times New Roman';font-size:14px">6</span><span style=";font-family:'Times New Roman';font-size:14px">+6+6</span></p></td></tr><tr style="height:30px;page-break-inside:avoid"><td width="126" valign="center" style="padding: 0px 7px; border-width: 1px 1px 2px 2px; border-color: windowtext;"><p><span style=";font-family:'Times New Roman';font-size:14px">初中地方课程</span></p></td><td width="97" valign="top" style="padding: 0px 7px; border-width: 1px 1px 2px; border-color: windowtext;"><p style=";text-align:center"><span style="font-family:'Times New Roman';font-size:14px">6</span></p></td><td width="217" valign="center" style="padding: 0px 7px; border-width: 1px 1px 2px; border-color: windowtext;"><p style="vertical-align: middle"><span style=";font-family:'Times New Roman';font-size:14px">人工智能赋能学科教学（小初高）</span></p></td><td width="93" valign="center" style="padding: 0px 7px; border-width: 1px 2px 2px 1px; border-color: windowtext;"><p style=";text-align:center"><span style=";font-family:'Times New Roman';font-size:14px">6+6+6</span></p></td></tr></tbody></table><p style="margin-right:0;text-indent:47px;text-autospace:ideograph-numeric;line-height:40px"><span style=";font-family:'Times New Roman';letter-spacing:1px;font-size:21px">5</span><span style=";font-family:仿宋_GB2312;letter-spacing:1px;font-size:21px">．</span><span style=";font-family:'Times New Roman';letter-spacing:1px;font-size:21px"><span style="font-family:仿宋_GB2312">课堂教学比赛</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">不安排在有参</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">赛</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">教师的学校。</span></span></p><p style="margin-right: 0;text-indent: 43px;line-height: 40px"><span style=";font-family:'Times New Roman';font-size:21px">6</span><span style=";font-family:仿宋_GB2312;font-size:21px">．</span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">各学科的</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">比赛</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">时间、地点、内容、操作程序、同分处理办法等其他要求，由市研究院相关学科负责人（联络人）发函通知。</span></span></p><p style="margin-right: 0;text-indent: 43px;line-height: 40px"><strong><span style="font-family: 'Times New Roman';font-size: 21px"><span style="font-family:仿宋_GB2312">（</span></span></strong><strong><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">三）评委专家的遴选与聘请</span></span></strong></p><p style="margin-right: 0;text-indent: 43px;line-height: 40px"><span style=";font-family:'Times New Roman';font-size:21px">1</span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">．</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">评</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">委</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">专家由政治素质过硬、思想品德好、业务水平高、在本学科（或项目）具有较高威望、有时间有精力参加评审的高级</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">及以上职称的</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">教师</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">或</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">教研员担任。评</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">委</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">专家须与市研究院签署保密协议，不得泄露评分、</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">比赛</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">结果等相关信息。聘期内如有评</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">委</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">专家不能承担或者不能胜任</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">比赛</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">工作，则由学科（项目）联系人提出申请，阐明理由，经分管纪检的院领导审核同意，更换评</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">委</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">专家。</span></span></p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:43px;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:40px"><span style=";font-family:'Times New Roman';font-size:21px">2</span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">．</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">抽取确定评委。在院纪检领导处按照区域平衡要求，从评</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">委</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">库随机抽签产生。</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">比赛</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">工作实行回避制度，评委回避本人所属区、县（市）参评人（论文）评</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">价</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">打分，如有本人、亲属、同校教师、同一名师工作室教师参加</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">比赛</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">活动，则应更换评委。</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">市研究院学科教研员（项目负责人）是上述两项学科教学</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">比赛</span></span><span style=";font-family:'Times New Roman';font-size:21px"><span style="font-family:仿宋_GB2312">的组织者，但不作为论文比赛的评委。</span></span></p><p>
