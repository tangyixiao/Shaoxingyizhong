<DIV>
<P class=MsoNormal style="MARGIN: 0cm 0cm 0pt"><SPAN style="FONT-FAMILY: 仿宋_GB2312; mso-hansi-font-family: 宋体"><FONT size=5>抄送：<SPAN lang=EN-US><SPAN style="mso-field-code: ' MERGEFIELD 抄送 \* MERGEFORMAT '"><SPAN lang=EN-US style="mso-no-proof: yes"><SPAN lang=EN-US>浙江省教育厅、市府办、综治办、维稳办、安监局、卫生局</SPAN></SPAN></SPAN></SPAN>。</FONT></SPAN></P></DIV></TD></TR></TBODY></TABLE></v:textbox><w:wrap anchory="page" anchorx="page"></w:wrap></v:shape><v:line id=_x0000_s1032 style="Z-INDEX: 7; LEFT: 0px; POSITION: absolute; TEXT-ALIGN: left; mso-position-horizontal-relative: page; mso-position-vertical-relative: page" to="518.75pt,683.75pt" from="70.9pt,683.75pt"><w:wrap anchory="page" anchorx="page"><FONT size=5></FONT></w:wrap></v:line><v:shape id=_x0000_s1028 style="MARGIN-TOP: 712.3pt; Z-INDEX: 3; LEFT: 0px; MARGIN-LEFT: 76.55pt; WIDTH: 439.35pt; TEXT-INDENT: 0px; POSITION: absolute; HEIGHT: 22.7pt; TEXT-ALIGN: left; mso-position-horizontal-relative: page; mso-position-vertical-relative: page" stroked="f" filled="f" type="#_x0000_t202"><v:textbox inset="0,0,0,0">
