<DIV>
<P class=MsoNormal style="MARGIN: 0cm 0cm 0pt"><SPAN style="FONT-FAMILY: 仿宋_GB2312"><FONT size=5>绍兴市教育局办公室<SPAN lang=EN-US><SPAN style="mso-spacerun: yes">                  </SPAN>2010</SPAN>年<SPAN lang=EN-US>5</SPAN>月<SPAN lang=EN-US>26</SPAN>日印发</FONT></SPAN></P></DIV></TD></TR></TBODY></TABLE></v:textbox><w:wrap anchory="page" anchorx="page"></w:wrap></v:shape><v:shape id=_x0000_s1029 style="MARGIN-TOP: 738.25pt; Z-INDEX: 4; LEFT: 0px; MARGIN-LEFT: 76.55pt; WIDTH: 439.35pt; TEXT-INDENT: 0px; POSITION: absolute; HEIGHT: 22.7pt; TEXT-ALIGN: left; mso-position-horizontal-relative: page; mso-position-vertical-relative: page" stroked="f" filled="f" type="#_x0000_t202"><v:textbox inset="0,0,0,0">
